#!/usr/bin/env bash
# Optional overrides — only needed if you do not want to edit scripts/open_rv.sh
# site defaults, or you keep machine-specific paths out of git.
#
#   cp scripts/open_rv.local.sh.example scripts/open_rv.local.sh
#   source scripts/open_rv.sh
#
# This file is sourced *after* open_rv.sh site defaults and overrides them.

